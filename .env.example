EVO_HELPER_HOST=127.0.0.1
EVO_HELPER_PORT=8000
EVO_HELPER_DRY_RUN=true
# 生产 2026-08-16 已切 PostgreSQL，两台机器共用一个库：
EVO_HELPER_DATABASE_URL=postgresql+psycopg://用户:密码@主机:5432/库名
#
# ⚠️ 装依赖时要带 `--extra db`（psycopg），不然控制台起不来。
# ⚠️ 数据库只监听私有网络（Tailscale）那块网卡，别裸奔在公网上。
# 历史数据搬迁与验证见 docs/postgres-migration.md。
#
# 只想在本机拿个空库随便试试，才用 SQLite——它和生产**不是同一种方言**
# （`/planets` 那次整页 500 就是 SQLite 容忍、PostgreSQL 报错）：
# EVO_HELPER_DATABASE_URL=sqlite:///var/evo-helper.db

# 系统日志（`system_log` 表）保留多少天。控制台每次启动清一次早于这个期限的行。
# 0 或负数表示**不清理**——不是「全删」，那张表是出事之后唯一能翻的东西。
# EVO_HELPER_SYSTEM_LOG_RETENTION_DAYS=14

# -- 换机器 / 换账号要改的五项 ------------------------------------------------

# 跨机器调写接口要带的票。不设的话只有同源请求能写，另一台机器指挥不动它。
# 生成一串：powershell -Command "[guid]::NewGuid().ToString('N')"
# EVO_HELPER_WEB_TOKEN=

# Tesseract 可执行文件。默认是 Windows 安装器的落点。
EVO_HELPER_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Chrome 可执行文件。留空则依次找 %LOCALAPPDATA%（安装器默认）、
# Program Files、Program Files (x86)。配了却找不到会直接报错，不回落。
# EVO_HELPER_CHROME_PATH=

# 页面 DPR，传给 Chrome 的 --force-device-scale-factor。
# 所有点击坐标和 OCR 的 ROI 编码的是「窗口物理尺寸 ÷ 缩放率」得到的 CSS 版面，
# 不是物理尺寸。钉死它，版面就跟目标机器的系统缩放率无关了。
#
# 这不是偏好项，是标定常量：**填 1.25 以外的值会被当场拒绝**。
# Chrome 的 --app 标题栏用的是同一个 scale factor，改了它，
# game_window.APP_TITLE_BAR_PX、CALIBRATED_VIEWPORT 和所有点击坐标 / ROI
# 都要跟着重新实测——而不重测的话不报错，只是每次点击都偏几个像素。
EVO_HELPER_DEVICE_SCALE_FACTOR=1.25

# 主星，写成 星系:恒星系:位置。换账号就要换：飞行时间、战报匹配、
# 海盗巡航范围全都从它算起。格式不对会当场报错，不会默默用默认值。
EVO_HELPER_ORIGIN=2:137:18

# -- 「你的行星被侦察」安全邮件告警（可选） -------------------------------
# 126 邮箱：设置 → POP3/SMTP/IMAP → 新增授权密码。这里填客户端授权码，
# 绝不填网页登录密码；.env 不应提交到 git。
# EVO_HELPER_ALERT_EMAIL_TO=your-recipient@example.com
# EVO_HELPER_SMTP_HOST=smtp.126.com
# EVO_HELPER_SMTP_PORT=465
# EVO_HELPER_SMTP_USERNAME=your-account@126.com
# EVO_HELPER_SMTP_PASSWORD=your-client-authorization-code
# EVO_HELPER_SMTP_USE_SSL=true
# EVO_HELPER_SMTP_FROM=your-account@126.com
